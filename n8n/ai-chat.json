{
  "name": "ai-chat-with-search",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ai-chat",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-node",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        100,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.body.message.toLowerCase() }}",
              "operation": "contains",
              "value2": "search"
            },
            {
              "value1": "={{ $json.body.message.toLowerCase() }}",
              "operation": "contains",
              "value2": "latest"
            },
            {
              "value1": "={{ $json.body.message.toLowerCase() }}",
              "operation": "contains",
              "value2": "who is"
            },
            {
              "value1": "={{ $json.body.message.toLowerCase() }}",
              "operation": "contains",
              "value2": "what is"
            }
          ]
        },
        "combineOperation": "any"
      },
      "id": "if-search-needed",
      "name": "Needs Web Search?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        300,
        300
      ]
    },
    {
      "parameters": {
        "url": "={{ 'https://api.duckduckgo.com/?q=' + encodeURIComponent($json.body.message) + '&format=json' }}",
        "options": {}
      },
      "id": "duckduckgo-search",
      "name": "DuckDuckGo API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        520,
        180
      ]
    },
    {
      "parameters": {
        "jsCode": "return {\n  message: $('Webhook').first().json.body.message,\n  context: \"\"\n};"
      },
      "id": "no-search-context",
      "name": "No Search Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        420
      ]
    },
    {
      "parameters": {
        "jsCode": "let searchData = $input.first().json;\nlet contextText = searchData.AbstractText || \"\";\nif (searchData.RelatedTopics && searchData.RelatedTopics.length > 0) {\n  contextText += \" \" + searchData.RelatedTopics.map(t => t.Text).join(\" \");\n}\nreturn {\n  message: $('Webhook').first().json.body.message,\n  context: contextText.trim() !== \"\" ? \"Web Search Results: \" + contextText : \"No relevant web results found.\"\n};"
      },
      "id": "format-search-results",
      "name": "Format Search",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        180
      ]
    },
    {
      "parameters": {
        "mode": "combine",
        "combineBy": "multiplex"
      },
      "id": "merge-node",
      "name": "Merge Context",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 2.1,
      "position": [
        920,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer YOUR_GROQ_API_KEY_HERE"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'llama-3.1-8b-instant', messages: [ { role: 'system', content: 'You are a helpful AI assistant. Answer the user\\'s message. If context is provided from a web search, use it to inform your answer.' }, { role: 'user', content: 'Context: ' + $json.context + '\\n\\nUser Message: ' + $json.message } ], temperature: 0.7 }) }}",
        "options": {}
      },
      "id": "groq-api",
      "name": "Call Groq AI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1120,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: true, reply: $json.choices[0].message.content }) }}",
        "options": {}
      },
      "id": "respond-node",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1320,
        300
      ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Needs Web Search?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Needs Web Search?": {
      "main": [
        [
          {
            "node": "DuckDuckGo API",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "No Search Context",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "DuckDuckGo API": {
      "main": [
        [
          {
            "node": "Format Search",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "No Search Context": {
      "main": [
        [
          {
            "node": "Merge Context",
            "type": "main",
            "index": 1
          }
        ]
      ]
    },
    "Format Search": {
      "main": [
        [
          {
            "node": "Merge Context",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Merge Context": {
      "main": [
        [
          {
            "node": "Call Groq AI",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call Groq AI": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "v1"
}
